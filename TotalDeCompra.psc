Algoritmo TotalDeCompra
	
	Definir precio,cantidad,total Como Entero
	
	precio = 12
	
	Escribir "================================="
	Escribir "       COMPRA DE CUADERNOS       "
	Escribir "================================="
	
	Escribir "Ingrese la cantida de cuadernos: "
	Leer cantidad
	
	total = cantidad * precio
	
	Escribir ""
	Escribir "---------------------------------"
	Escribir "Cantidad de cuadernos: ", cantidad
	Escribir "Total a pagar: ", total, " Bs"
	Escribir "---------------------------------"
 
	
FinAlgoritmo
