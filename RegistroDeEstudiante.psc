Algoritmo RegistroDeEstudiante
	
	Definir Nombre, Carrera Como Caracter
	Definir Edad, Semestre Como Entero
	
	Escribir "================================="
	Escribir "      REGISTRO DE ESTUDIANTE     "
	Escribir "================================="
	
	Escribir "Ingrese el nombre del estudiante:"
	Leer Nombre
	
	Escribir "Ingrese la edad del estudiante:"
	Leer Edad
	
	Escribir "Ingrese la carrera del estudiante:"
	Leer Carrera
	
	Escribir "Ingrese el semestre que cursa:"
	Leer Semestre
	
	Escribir ""
	Escribir "================================="
	Escribir "        DATOS DEL ESTUDIANTE     "
	Escribir "================================="
	
	Escribir "Nombre   : ", Nombre
	Escribir "Edad     : ", Edad, " años"
	Escribir "Carrera  : ", Carrera
	Escribir "Semestre : ", Semestre
	
FinAlgoritmo